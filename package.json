{
  "name": "@egym/capacitor-nfc-pass-wallet",
  "version": "0.4.0",
  "description": "Capacitor plugin for NFC pass wallet integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/egym/lib-capacitor-nfc-pass-wallet"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "android/src/main",
    "android/build.gradle",
    "android/gradle.properties",
    "ios",
    "Package.swift",
    "CapacitorNFCPassWallet.podspec"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:lockfile": "node ./scripts/verify-lockfile.mjs",
    "release:prepare": "bash ./scripts/release-prepare.sh",
    "lint:ts": "npm run typecheck",
    "lint:android": "if [ \"$USE_SYSTEM_ANDROID_SDK\" = \"1\" ]; then cd android && ./gradlew lint; elif command -v devenv >/dev/null 2>&1; then devenv shell -- sh -c 'cd android && ./gradlew lint'; else cd android && ./gradlew lint; fi",
    "lint:ios": "pod lib lint CapacitorNFCPassWallet.podspec --allow-warnings",
    "build:android": "if [ \"$USE_SYSTEM_ANDROID_SDK\" = \"1\" ]; then cd android && ./gradlew assemble; elif command -v devenv >/dev/null 2>&1; then devenv shell -- sh -c 'cd android && ./gradlew assemble'; else cd android && ./gradlew assemble; fi",
    "build:ios": "pod lib lint CapacitorNFCPassWallet.podspec --allow-warnings"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.4.2",
    "@changesets/cli": "^2.29.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  }
}
